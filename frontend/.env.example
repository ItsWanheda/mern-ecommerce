# Next.js public storefront settings. Copy to frontend/.env.local for local development. These values are browser-visible.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_PUBLIC_SITE_URL=
NEXT_PUBLIC_STORE_SUPPORT_EMAIL=

# Optional storefront footer links. Set these to the real public profiles for Tik Boutique.
NEXT_PUBLIC_STORE_INSTAGRAM_URL=
NEXT_PUBLIC_STORE_TELEGRAM_URL=
NEXT_PUBLIC_STORE_X_URL=

# Use the exact image/embed URL and verification URL issued for this shop by eNAMAD.
# Leave blank until the store has its own official seal.
NEXT_PUBLIC_ENAMAD_SEAL_IMAGE_URL=
NEXT_PUBLIC_ENAMAD_SEAL_LINK_URL=
