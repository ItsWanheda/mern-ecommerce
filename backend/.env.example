# PostgreSQL / Prisma. Use a new, empty PostgreSQL 16+ database for this branch.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
PRISMA_QUERY_LOGGING=false

# Redis is retained for refresh-token storage, cache, and distributed rate limits.
REDIS_URL="redis://127.0.0.1:6379"
# Legacy managed Redis alternative; use one of REDIS_URL or UPSTASH_REDIS_URL.
UPSTASH_REDIS_URL=

# Generate unique, high-entropy values. Never reuse the examples in production.
ACCESS_TOKEN_SECRET="replace-with-a-long-random-secret"
REFRESH_TOKEN_SECRET="replace-with-a-different-long-random-secret"
RATE_LIMIT_KEY_SALT="replace-with-a-third-long-random-secret"
CRON_SECRET="replace-with-a-long-random-cron-secret"

NODE_ENV=development
PORT=5000
API_URL=https://api.example.ir
APP_URL=https://store.example.ir
FRONTEND_URL=https://store.example.ir
CLIENT_URL=https://store.example.ir
CORS_ALLOWED_ORIGINS=https://store.example.ir

# Commerce is IRT (Toman) + Zarinpal only. Keep false until catalogue prices
# have been audited and confirmed as whole-Toman values.
IRT_CATALOG_PRICES_CONFIRMED=false
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
DEFAULT_SHIPPING_FEE=0
FREE_SHIPPING_THRESHOLD=0

# Optional media and email integrations.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
EMAIL_FROM=Computer Hardware Store <no-reply@example.ir>

# Required only for the one-time fresh Admin creation command.
ALLOW_ADMIN_BOOTSTRAP=false
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
