# PostgreSQL connection used by Prisma after the application database cutover.
# Do not commit real credentials. Keep Redis configuration separate and unchanged.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Optional: enable Prisma query logs locally. Keep disabled in production unless needed.
PRISMA_QUERY_LOGGING=false

# Required only for the one-time initial Admin bootstrap command.
ALLOW_ADMIN_BOOTSTRAP=false
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
